# Copiar como .env y cambiar los valores antes de ejecutar Compose.
# NO subir .env a GitHub.
DJANGO_SECRET_KEY=REEMPLAZAR_CON_UN_VALOR_ALEATORIO_SEGURO
DEBUG=False
DB_NAME=finansmart
DB_USER=finansmart
DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_FUERTE
ALLOWED_HOSTS=localhost,127.0.0.1,django_web
CSRF_TRUSTED_ORIGINS=
HTTP_PORT=8080
# Activar solo al desplegar el override TLS y obtener el certificado.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
RECOMMENDATION_ENGINE=REMOTE
RECOMMENDATION_SERVICE_URL=http://recommendation_service:5000/api/v2/recommendations/
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Volt: origen sin la ruta /api/chatbot/message/. No requiere token.
VOLT_BASE_URL=
